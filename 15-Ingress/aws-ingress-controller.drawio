        </mxCell>
        <mxCell id="flow-title" parent="aws-cloud" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#232F3E;" value="Traffic Flow (Numbered Steps)" vertex="1">
          <mxGeometry height="25" width="250" x="70" y="430" as="geometry" />
        </mxCell>
        <mxCell id="flow-steps" parent="aws-cloud" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#424242;spacingLeft=10;" value="1️⃣ User queries DNS → 2️⃣ Route53 resolves to ALB DNS → 3️⃣ ALB Listener:443 receives request&#xa;4️⃣ Routing Rules evaluate Host header → 5️⃣ Routes to Target Group based on hostname&#xa;6️⃣ Target Group forwards to pod IPs (target-type: ip, no NodePort needed)" vertex="1">
          <mxGeometry height="50" width="650" x="70" y="460" as="geometry" />
        </mxCell>
        <mxCell id="concepts-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="120" width="600" x="100" y="760" as="geometry" />
        </mxCell>
        <mxCell id="concepts-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#2E7D32;" value="Key Annotations Explained" vertex="1">
          <mxGeometry height="25" width="250" x="120" y="770" as="geometry" />
        </mxCell>
        <mxCell id="concepts-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#1B5E20;spacingLeft=10;" value="✅ group.name: roboshop → Both apps share ONE ALB (cost optimization)&lt;br&gt;✅ target-type: ip → Pods registered directly as targets (lower latency)&lt;br&gt;✅ scheme: internet-facing → ALB gets public IP&lt;br&gt;✅ certificate-arn → SSL/TLS certificate from ACM&lt;br&gt;✅ Host-based routing → app1.servicewiz.in vs app2.servicewiz.in" vertex="1">
          <mxGeometry height="70" width="560" x="120" y="800" as="geometry" />
        </mxCell>
        <mxCell id="setup-box" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=2;" value="" vertex="1">
          <mxGeometry height="120" width="580" x="720" y="760" as="geometry" />
        </mxCell>
        <mxCell id="setup-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontStyle=1;fontColor=#E65100;" value="4-Step Setup Process" vertex="1">
          <mxGeometry height="25" width="250" x="740" y="770" as="geometry" />
        </mxCell>
        <mxCell id="setup-text" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#BF360C;spacingLeft=10;" value="1️⃣ Install OIDC Provider → eksctl utils associate-iam-oidc-provider&#xa;2️⃣ Create IAM Policy → Permissions for ALB, TargetGroup, Listener creation&#xa;3️⃣ Create ServiceAccount + IAM Role → eksctl create iamserviceaccount&#xa;4️⃣ Install AWS LB Controller → helm install aws-load-balancer-controller" vertex="1">
          <mxGeometry height="70" width="540" x="740" y="800" as="geometry" />
        </mxCell>
        <mxCell id="footer" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=12;fontColor=#757575;" value="Created by Ramu Chelloju | DevOps Engineer with 5 YOE | AWS ☁️ Kubernetes ☸️ Terraform 🏗️" vertex="1">
          <mxGeometry height="25" width="1200" x="100" y="900" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
